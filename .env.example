# Development defaults only. Never commit real credentials.
# Local non-container development URI; Compose overrides this with its private app-user URI.
QOIN_MONGODB_URI=mongodb://127.0.0.1:27017
QOIN_MONGODB_DATABASE=qoin

# Required by docker-compose.yml. Generate passwords as URL-safe hex, e.g. openssl rand -hex 32.
MONGO_INITDB_ROOT_USERNAME=qoin_root
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
QOIN_MONGODB_APP_USERNAME=qoin_app
QOIN_MONGODB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
QOIN_PUBLIC_PORT=8080
QOIN_AXUM_ADDR=127.0.0.1:8081
QOIN_AXUM_INTERNAL_ADDR=127.0.0.1:8081
QOIN_AXUM_URL=http://127.0.0.1:8081
QOIN_AXUM_WS_URL=ws://127.0.0.1:8081
QOIN_DROGON_PORT=8080
RUST_LOG=info

# Hard safety defaults: no live execution route is registered in Axum.
QOIN_TRADING_MODE=disabled
QOIN_LIVE_TRADING_CONFIRM=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
QOIN_MAX_ORDER_NOTIONAL_USDT=25
QOIN_MAX_ORDER_QUANTITY=0.001

# Read-only public market stream adapter. Defaults to BTCUSDT, ETHUSDT and SOLUSDT.
QOIN_BINANCE_STREAM_ENABLED=true
QOIN_BINANCE_STREAM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT

# Optional public spot market streams; no API key required for public trades.
QOIN_KRAKEN_STREAM_ENABLED=true
QOIN_KRAKEN_STREAM_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
QOIN_COINBASE_STREAM_ENABLED=true
QOIN_COINBASE_STREAM_PRODUCTS=BTC-USD,ETH-USD,SOL-USD

# Optional Finnhub news and extended-market provider. Never commit a real key.
FINNHUB_API_KEY=
QOIN_FINNHUB_STREAM_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,OANDA:EUR_USD,OANDA:GBP_USD,OANDA:USD_JPY,OANDA:AUD_USD,OANDA:SPX500_USD,OANDA:NAS100_USD,OANDA:US30_USD,OANDA:DE30_EUR,OANDA:XAU_USD,OANDA:XAG_USD,OANDA:WTICO_USD,OANDA:BCO_USD,OANDA:NATGAS_USD

# Firebase client configuration is supplied separately to each frontend app; never commit credentials.
