# Development defaults only. Never commit real credentials.
QOIN_MONGODB_URI=mongodb://127.0.0.1:27017
QOIN_MONGODB_DATABASE=qoin
QOIN_AXUM_ADDR=127.0.0.1:8081
QOIN_AXUM_URL=http://127.0.0.1:8081
QOIN_DROGON_PORT=8080
QOIN_RESEARCH_API_ADDR=127.0.0.1:8082
QOIN_RESEARCH_API_URL=http://127.0.0.1:8082
# Firebase project ID must match the client Firebase project. Never commit real keys.
QOIN_FIREBASE_PROJECT_ID=
# Comma-separated browser origins allowed to call the research API.
QOIN_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
VITE_QOIN_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_QOIN_API_URL=http://10.0.2.2:8080
RUST_LOG=info

# Hard safety defaults: no live execution route is registered in Axum.
QOIN_TRADING_MODE=disabled
QOIN_LIVE_TRADING_CONFIRM=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
QOIN_MAX_ORDER_NOTIONAL_USDT=25
QOIN_MAX_ORDER_QUANTITY=0.001
