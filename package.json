{
  "name": "qoin",
  "private": true,
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @qoin/react-web dev",
    "dev:mobile": "pnpm --filter @qoin/mobile start",
    "dev:api": "cargo run --manifest-path backend/rust-axum/Cargo.toml",
    "dev:gateway": "cmake -S backend/cpp-drogon -B build/drogon && cmake --build build/drogon",
    "test:api": "cargo test --workspace",
    "build": "turbo run build",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}
