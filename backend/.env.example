# Development defaults only. Never commit real credentials.
QOIN_MONGODB_URI=mongodb://127.0.0.1:27017
QOIN_MONGODB_DATABASE=qoin
QOIN_AXUM_ADDR=127.0.0.1:8081
QOIN_AXUM_URL=http://127.0.0.1:8081
QOIN_DROGON_PORT=8080
RUST_LOG=info

# Causal state-memory half-lives in milliseconds; research baselines, not tuned edge parameters.
QOIN_FLOW_HALF_LIFE_MS=5000
QOIN_EVENT_INTENSITY_HALF_LIFE_MS=2000
QOIN_LIQUIDATION_HALF_LIFE_MS=30000
QOIN_VOLATILITY_HALF_LIFE_MS=60000

# Separate service credentials. Empty values intentionally deny writes.
QOIN_INGEST_TOKEN=
QOIN_ADMIN_TOKEN=

# Signal/cost/regime inputs remain unset or false until walk-forward calibrated.
QOIN_EXPECTED_EDGE_BPS=
QOIN_FEE_BPS=
QOIN_SLIPPAGE_BPS=
QOIN_REGIME_ALLOWED=false

# Unknown risk caps are required; absent values veto entries.
QOIN_MAX_POSITIONS=
QOIN_MAX_CORRELATED_EXPOSURE_FRACTION=
QOIN_MAX_DAILY_LOSS_FRACTION=
QOIN_MAX_WEEKLY_LOSS_FRACTION=
QOIN_MAX_DRAWDOWN_FRACTION=
QOIN_RISK_MAX_SPREAD_BPS=
QOIN_RISK_MAX_SLIPPAGE_BPS=
QOIN_MAX_FEED_AGE_MS=
QOIN_RISK_MIN_STATE_QUALITY=

# Hard safety defaults: no live execution route is registered in Axum.
QOIN_TRADING_MODE=disabled
QOIN_LIVE_TRADING_CONFIRM=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
QOIN_MAX_ORDER_NOTIONAL_USDT=25
QOIN_MAX_ORDER_QUANTITY=0.001
