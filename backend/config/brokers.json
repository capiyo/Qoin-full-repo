{
  "schema_version": 1,
  "purpose": "Broker capability registry and deterministic broker-selection policy for Qoin.",
  "safety": {
    "default_mode": "paper",
    "live_order_routing_enabled": false,
    "require_explicit_live_broker_approval": true,
    "require_human_approval_per_live_account": true,
    "never_fallback_to_live_broker_automatically": true,
    "credentials_source": "secret_manager_only",
    "withdrawal_permissions_required": false,
    "note": "A catalog entry is not proof that an adapter, account, instrument, or API is currently available. Verify the exact contracting entity, jurisdiction, instrument, fees, and API before enabling."
  },
  "selection": {
    "strategy": "capability_filter_then_rank",
    "selection_scope": "per_instrument_and_account",
    "user_preference": "honor_explicit_preference_if_eligible",
    "mode_order": ["paper", "live"],
    "filters": [
      "broker.enabled",
      "broker.adapter_status == implemented",
      "broker.supported_modes contains requested_mode",
      "instrument.market is supported",
      "instrument.symbol_or_contract is supported",
      "account.jurisdiction is supported",
      "account_is_verified",
      "required_market_data_is_available",
      "instrument_trading_permissions_are_enabled",
      "minimum_order_and_margin_fit_risk_policy",
      "fees_and_expected_slippage_are_within_limits"
    ],
    "ranking": [
      "explicit_user_preference",
      "exact_instrument_and_venue_support",
      "jurisdiction_and_account_eligibility",
      "paper_or_testnet_support",
      "market_data_quality_and_history",
      "total_execution_cost",
      "minimum_order_size_and_margin_fit",
      "adapter_reliability"
    ],
    "no_eligible_broker": "return_no_route_and_explain_failed_requirements",
    "tie_break": "stable_broker_id_ascending",
    "live_routing": "disabled_until_risk_policy_and_human_approval_gates_are_satisfied"
  },
  "markets": ["forex", "stocks", "crypto", "commodities"],
