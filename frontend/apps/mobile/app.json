{
  "expo": {
    "name": "Qoin",
    "slug": "qoin",
    "scheme": "qoin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F9FC",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#F7F9FC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "co.qoin.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F9FC"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Qoin to select a profile picture from your photo library."
        }
      ]
    ]
  }
}
