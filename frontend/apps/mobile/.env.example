# Set these to a gateway address reachable from the Android device (LAN IP or deployed HTTPS/WSS URL).
# Do not use 127.0.0.1 on a physical device unless the gateway runs on that device.
EXPO_PUBLIC_QOIN_API_URL=
EXPO_PUBLIC_QOIN_WS_URL=

# Firebase client configuration (public identifiers only; enforce access with Firebase Security Rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
